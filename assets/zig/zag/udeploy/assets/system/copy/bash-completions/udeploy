# Completion is static metadata: never run a deployment to produce suggestions.
_udeploy_complete() {
    local cur=${COMP_WORDS[COMP_CWORD]-} prev='' word capture=0 mode=0 adopt=0
    local tasks='workstation all shell configs profile bashrc bash-completions lemonade-config nvim-config ghostty-config fonts go go-tools rust rust-tools llvm zig wlroots river neovim luals zls'
    local flags='--preview --apply --capture --refresh --adopt --doctor --assets --go-ref --help'
    local -a candidates=()
    COMPREPLY=()
    (( COMP_CWORD == 0 )) || prev=${COMP_WORDS[COMP_CWORD-1]}
    case "$prev" in
        --assets)
            while IFS= read -r word; do COMPREPLY+=("$word"); done < <(compgen -d -- "$cur")
            compopt -o filenames 2>/dev/null || :
            return 0 ;;
        --go-ref) return 0 ;;
    esac
    for word in "${COMP_WORDS[@]}"; do
        case "$word" in
            --capture) capture=1; mode=1 ;;
            --preview|--apply) mode=1 ;;
            --adopt) adopt=1 ;;
        esac
    done
    if (( capture )); then tasks='shell configs profile bashrc bash-completions lemonade-config nvim-config ghostty-config'; fi
    if (( adopt )); then tasks='llvm zig wlroots river neovim luals go-tools rust'; fi
    if [[ $cur == -* ]]; then
        read -r -a candidates <<< "$flags"
    else
        read -r -a candidates <<< "$tasks"
    fi
    for word in "${candidates[@]}"; do
        if (( mode )) && [[ $word == --preview || $word == --apply || $word == --capture ]]; then continue; fi
        [[ $word != "$cur"* ]] || COMPREPLY+=("$word")
    done
    return 0
}
complete -F _udeploy_complete udeploy
